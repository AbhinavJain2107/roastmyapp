{
  "name": "roastmyapp",
  "version": "0.1.2",
  "description": "CLI to scan Next.js apps for performance issues, score them, and apply safe auto-fixes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhinavJain2107/Roastmyapp.git"
  },
  "homepage": "https://github.com/AbhinavJain2107/Roastmyapp#readme",
  "bugs": {
    "url": "https://github.com/AbhinavJain2107/Roastmyapp/issues"
  },
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "roastmyapp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "nextjs",
    "next.js",
    "performance",
    "next-performance",
    "cli",
    "web-performance",
    "core-web-vitals",
    "lcp",
    "image-optimization",
    "bundle-optimization",
    "static-analysis",
    "codemod",
    "web-vitals",
    "optimization"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.5"
  }
}
